# Auto detect text files and perform LF normalization
* text=auto

# C# files
*.cs text diff=csharp
*.csproj text
*.sln text

# Godot files
*.gd text
*.tscn text diff=godot-scene
*.tres text
*.godot text
*.gdnlib text
*.gdextension text

# YML/YAML
*.yml text
*.yaml text

# Markdown
*.md text diff=markdown

# Shell scripts
*.sh text eol=lf
*.bash text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.wav binary
*.ogg binary
*.mp3 binary
*.glb binary
*.svg text
*.ttf binary
*.otf binary
*.dll binary
*.pdb binary
